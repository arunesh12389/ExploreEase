{
  "compilerOptions": {
    /* Base Settings */
    "module": "ESNext",
    "moduleResolution": "bundler", 
    "target": "ES2020",
    "jsx": "react-jsx",
    
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false, 
    "skipLibCheck": true, 
    
    "baseUrl": ".",
    "paths": {
      "@/*": ["./client/src/*"],
      "@shared/*": ["./shared/*"]
    },
    

    "lib": ["esnext", "dom", "dom.iterable"],
    "types": [], 
    "noEmit": true
  },
  
  "include": [
    "client/src/**/*", 
    "shared/**/*", 
    "server/**/*"
  ],
  "exclude": [
    "node_modules", 
    "build", 
    "dist"
  ]
}

